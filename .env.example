# Ladder instance secrets — TEMPLATE (committed). Copy to .env and fill values.
# .env is gitignored; .env.example carries names only, never values.
ANTHROPIC_API_KEY=

# Maturity classifier (Sprint Ma Task 2) — gbrain query-server retrieval.
# CLASSIFIER_QUERY_URL: gbrain HTTP server base for the reference instance (client posts to {URL}/mcp).
# CLASSIFIER_QUERY_TOKEN: legacy bearer token minted via `gbrain auth create` (SECRET).
CLASSIFIER_QUERY_URL=
CLASSIFIER_QUERY_TOKEN=

# Optional judge overrides. Model default (unset) = claude-opus-4-8 (ruled baseline).
# CLASSIFIER_JUDGE_MODEL=
# CLASSIFIER_JUDGE_EFFORT=
